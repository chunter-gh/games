/* =========================================================
   RESIZE
   ========================================================= */

function resizeBoardToAvailableSpace(){

    if(
        !boardShadowElement ||
        !gameElement
    ){
        return;
    }

    const gameRect=
        gameElement.getBoundingClientRect();

    const tableStyle=
        getComputedStyle(
            document.querySelector(
                ".table"
            )
        );

    const top=
        boardShadowElement
            .getBoundingClientRect()
            .top;

    const messageHeight=
        messageElement
            ? messageElement
                .getBoundingClientRect()
                .height
            : 0;

    const controlsHeight=
        controlsElement
            ? controlsElement
                .getBoundingClientRect()
                .height
            : 0;

    const messageMargin=
        messageElement
            ? parseFloat(
                getComputedStyle(
                    messageElement
                ).marginTop
            ) || 0
            : 0;

    const controlsMargin=
        controlsElement
            ? parseFloat(
                getComputedStyle(
                    controlsElement
                ).marginTop
            ) || 0
            : 0;

    const bottomPadding=
        Math.max(
            2,
            parseFloat(
                tableStyle.paddingBottom
            ) || 0
        );

    const availableWidth=
        Math.min(
            gameRect.width,
            window.innerWidth*.96
        );

    const availableHeight=
        window.innerHeight-
        top-
        messageHeight-
        controlsHeight-
        messageMargin-
        controlsMargin-
        bottomPadding-
        2;

    let size=
        Math.min(
            availableWidth,
            availableHeight
        );

    size=
        Math.min(
            size,
            650
        );

    size=
        Math.max(
            120,
            Math.floor(size)
        );

    boardShadowElement.style.setProperty(
        "--board-size",
        size+"px"
    );
}

window.addEventListener(
    "resize",
    resizeBoardToAvailableSpace
);

window.addEventListener(
    "orientationchange",
    ()=>{
        setTimeout(
            resizeBoardToAvailableSpace,
            100
        );
    }
);

/* =========================================================
   INITIALIZE
   ========================================================= */

function initialize(){

    if(onlineMode){

        computerMode=false;

        difficultyElement.disabled=true;

        computerButton.disabled=true;

        /*
         * Both players start with the exact same
         * initial board.
         *
         * Nobody sends a state merely by connecting.
         */
        boardState=
            createInitialBoard();

        currentPlayer=
            BLACK;

        gameOver=false;

        lastMove=null;

        renderScores();

        renderBoard(
            getValidMoves(
                currentPlayer
            )
        );

        updateTurnDisplay();

        connectToRoom();

    }else{

        computerMode=true;

        difficultyElement.disabled=false;

        computerButton.disabled=true;

        renderScores();

        renderBoard(
            getValidMoves(
                currentPlayer
            )
        );

        updateTurnDisplay();

        updateMessage(
            "Onyx begins."
        );
    }

    requestAnimationFrame(
        ()=>{
            resizeBoardToAvailableSpace();
        }
    );
}

initialize();

