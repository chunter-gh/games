=========================================================
BUTTONS
=========================================================
*/

undoButton.addEventListener(
    "click",
    restoreState
);

document
.getElementById("newGameButton")
.addEventListener(
    "click",
    newGame
);

document
.getElementById("winNewGame")
.addEventListener(
    "click",
    ()=>{
        winOverlay.classList.remove("show");
        newGame();
    }
);


