    }
);

computerButton.addEventListener(
    "click",
    () => {

        if (onlineMode) {

            if (socket) {

                try {
                    socket.close();
                } catch (error) {
                }
            }

            window.location.href =
                "rooms.html?game=othello";

            return;
        }

        localMode =
            "computer";

        updateModeUI();

        startNewGame();
    }
);

difficultyElement.addEventListener(
    "change",
    () => {

        if (
            !onlineMode &&
            modeIsComputer()
        ) {

            setMessage(
                "Difficulty changed."
            );
        }
    }
);

/* =========================================================
   BUTTONS
   ========================================================= */

newGameButton.addEventListener(
    "click",
    () => {

        startNewGame();
    }
);

menuButton.addEventListener(
    "click",
    () => {

        if (socket) {

            try {
                socket.close();
            } catch (error) {
            }
        }

        window.location.href =
            "index.html";
    }
);

/* =========================================================
   INITIALIZE
   ========================================================= */

function initialize() {

    scheduleBoardResize();

    if (onlineMode) {

        localMode =
            "2player";

        twoPlayerButton.textContent =
            "2 PLAYERS";

        computerButton.textContent =
            "VS COMPUTER";

        twoPlayerButton.classList.add(
            "active"
        );

        computerButton.classList.remove(
            "active"
        );

        difficultyGroup.classList.add(
            "hidden"
        );

        boardState =
            createInitialBoard();

        currentPlayer =
            BLACK;

        gameStarted =
            false;

        gameOver =
            false;

        opponentConnected =
            false;

        renderBoard([]);

        setTurnMessage(
            "CONNECTING"
        );

        setMessage(
            playerNumber === 1
                ? "Connecting as Black..."
                : "Connecting as Ivory..."
        );

        connectToRoom();

        return;
    }

    localMode =
        "computer";

    twoPlayerButton.textContent =
        "2 PLAYERS";

    computerButton.textContent =
        "VS COMPUTER";

    difficultyGroup.classList.remove(
        "hidden"
    );

    updateModeUI();

    boardState =
        createInitialBoard();

    currentPlayer =
        BLACK;

    gameStarted =
        true;

    renderBoard(
        getValidMoves(BLACK)
    );

    setTurnMessage("BLACK");

    setMessage(
        "Black's turn."
    );

    scheduleBoardResize();
}

initialize();

setTimeout(
    scheduleBoardResize,
    50
);

setTimeout(
    scheduleBoardResize,
    250
);

</script>

